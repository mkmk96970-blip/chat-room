{
  "expo": {
    "name": "چت روم",
    "slug": "chat-room",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "jsEngine": "jsc",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2E86AB"
    },
    "ios": {
      "supportsTablet": true,
      "jsEngine": "jsc"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E86AB"
      },
      "package": "com.chatroom.app",
      "jsEngine": "jsc"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "چت روم",
      "shortName": "چت روم",
      "description": "اپلیکیشن چت پیشرفته با قابلیت‌های گروهی، تماس و پیام‌رسانی",
      "themeColor": "#2E86AB",
      "backgroundColor": "#2E86AB",
      "display": "standalone",
      "orientation": "portrait"
    }
  }
}
